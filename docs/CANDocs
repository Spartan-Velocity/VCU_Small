19. Practical Tips & Gotchas
Always call begin() first. Any other call before it can hard-fault the board.
Default-deny, then allow. Start filters from REJECT_ALL and explicitly open up the IDs you want — it's much easier to reason about than starting from "accept everything."
Multi-ID filters can bleed through. If a mailbox/FIFO filter set for several specific IDs also lets a couple of unexpected IDs in, that's expected CAN mask behavior — fix it with enhanceFilter().
First match wins, unless you distribute(). If two mailboxes/filters could both catch the same frame, only one actually will, by default.
FIFO never transmits. It's RX-only; use mailboxes (write()) for sending.
Interrupt-driven and polled sources don't overlap. read()/readMB()/readFIFO() never touch mailboxes you've enabled interrupts on — those are drained only through events() + callbacks.
events() needs to run often — put it in loop(), an IntervalTimer, or a cooperative thread; callbacks (and sequential-frame transmission) only fire when it's called.
Only Teensy 4's CAN3 does FD. Every other bus/board combination is CAN 2.0 only.
Bigger RX/TX queue templates cost RAM. Size them to your actual traffic burst needs, not just "as large as possible."
20. Complete Example Sketches
20.1 CAN 2.0 — FIFO + filtering + callback + polling TX
#include <FlexCAN_T4.h>

FlexCAN_T4<CAN1, RX_SIZE_256, TX_SIZE_16> Can1;

void canSniff(const CAN_message_t &msg) {
  Serial.print("MB "); Serial.print(msg.mb);
  Serial.print("  LEN: "); Serial.print(msg.len);
  Serial.print("  ID: 0x"); Serial.print(msg.id, HEX);
  Serial.print("  DATA:");
  for (uint8_t i = 0; i < msg.len; i++) {
    Serial.print(" "); Serial.print(msg.buf[i], HEX);
  }
  Serial.println();
}

void setup() {
  Serial.begin(115200);

  Can1.begin();
  Can1.setBaudRate(500000);

  Can1.enableFIFO();
  Can1.enableFIFOInterrupt();
  Can1.onReceive(FIFO, canSniff);

  Can1.setFIFOFilter(REJECT_ALL);
  Can1.setFIFOFilter(0, 0x123, STD);   // only let 0x123 through
  Can1.enhanceFilter(FIFO);

  Can1.mailboxStatus();
}

void loop() {
  Can1.events();

  static uint32_t last = 0;
  if (millis() - last > 500) {
    last = millis();
    CAN_message_t msg;
    msg.id = 0x321;
    msg.len = 8;
    for (uint8_t i = 0; i < 8; i++) msg.buf[i] = i;
    Can1.write(msg);
  }
}
20.2 CAN FD — custom timing, wide mailboxes, mailbox filter
#include <FlexCAN_T4.h>

FlexCAN_T4FD<CAN3, RX_SIZE_256, TX_SIZE_16> FD;

void fdSniff(const CANFD_message_t &msg) {
  Serial.print("ID: 0x"); Serial.print(msg.id, HEX);
  Serial.print("  LEN: "); Serial.print(msg.len);
  Serial.print("  BRS: "); Serial.println(msg.brs);
}

void setup() {
  Serial.begin(115200);
  FD.begin();

  CANFD_timings_t config;
  config.clock      = CLK_24MHz;
  config.baudrate   = 1000000;
  config.baudrateFD = 2000000;
  config.propdelay  = 190;
  config.bus_length = 1;
  config.sample     = 75;
  FD.setBaudRate(config);

  FD.setRegions(64);            // fewer, larger (64-byte) mailboxes
  FD.setMB(MB0, RX, STD);
  FD.setMBFilter(REJECT_ALL);
  FD.setMBFilter(MB0, 0x123);
  FD.onReceive(MB0, fdSniff);
  FD.enableMBInterrupt(MB0);

  FD.mailboxStatus();
}

void loop() {
  FD.events();

  static uint32_t last = 0;
  if (millis() - last > 500) {
    last = millis();
    CANFD_message_t msg;
    msg.id = 0x456;
    msg.len = 32;
    msg.brs = 1;
    msg.edl = 1;
    for (uint8_t i = 0; i < msg.len; i++) msg.buf[i] = i;
    FD.write(msg);
  }
}
